{
  "$defs": {
    "Element": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "className": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classname"
        },
        "type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "title": "Element",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "maxLength": 40,
          "title": "Unit",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "id",
        "name",
        "unit"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "project": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Project",
          "type": "string"
        },
        "study_case": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Study Case",
          "type": "string"
        },
        "source": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "completed",
          "enum": [
            "completed",
            "partial",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "project",
        "study_case",
        "source"
      ],
      "title": "Run",
      "type": "object"
    },
    "Sample": {
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "element_id": {
          "title": "Element Id",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "warning",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "element_id",
        "metric_id",
        "value"
      ],
      "title": "Sample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/Element"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Elements",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/Sample"
      },
      "maxItems": 250000,
      "title": "Samples",
      "type": "array"
    }
  },
  "required": [
    "run",
    "elements",
    "metrics",
    "samples"
  ],
  "title": "RunBundle",
  "type": "object"
}
