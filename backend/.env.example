# Copy to backend/.env; real settings remain ignored by Git.
APP_ENV=development
ANALYSIS_MODE=demo
# SQLite mode never adds seed data automatically.
# ANALYSIS_MODE=sqlite
# ANALYSIS_DB_PATH=/absolute/path/to/analysis.sqlite3

# Required in production: generate using python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Existing Oracle login is the default. Independent SQLite installations may use local.
AUTH_BACKEND=oracle
# AUTH_BACKEND=local
# LOCAL_USERNAME=analyst
# Generate interactively: python scripts/hash_password.py
# LOCAL_PASSWORD_HASH=

# Oracle values are optional until FDWH access / Oracle login is needed.
DB_HOST=localhost
DB_PORT=1521
DB_NAME=
DB_USER=
DB_PASSWORD=
# DATABASE_URL=oracle+oracledb://USER:PASSWORD@HOST:1521/?service_name=SERVICE
# ADMIN_USERS=

# Use the Vite proxy or same-origin production to avoid CORS.
CORS_ORIGINS=
ENABLE_HSTS=0
DUCKDB_ENABLED=false
DUCKDB_PATH=
DUCKDB_FALLBACK_TO_ORACLE=true
DUCKDB_RETENTION_YEARS=10
DUCKDB_RECENT_RAW_MONTHS=3
DUCKDB_HOURLY_YEARS=3
DUCKDB_SYNC_MODE=external
